# Postgres (matches docker-compose.yml)
DATABASE_URL=postgres://safebook:safebook@localhost:5432/safebook

# HTTP
PORT=3000

# Folders the worker watches and archives into
INBOX_DIR=./inbox
ARCHIVE_DIR=./archive
FAILED_DIR=./failed
# Where a registered file is moved to, so the inbox does not grow without bound
# and ticks stop re-hashing it. Set MOVE_PROCESSED=false to leave files in place
# (e.g. a shared drive the customer also uses).
PROCESSED_DIR=./processed
MOVE_PROCESSED=true

# Polling (the assigner confirmed there are no file-arrival alerts)
POLL_INTERVAL_MS=2000
STABLE_AFTER_MS=2000

# Upload guards
MAX_UPLOAD_BYTES=26214400

# Claude.
#   off      (default) no escalation. Fields whose deterministic rule fails are
#            flagged for review and the document still persists. Runs with NO KEY.
#   live     call Claude when a rule fails. Needs ANTHROPIC_API_KEY.
#   record   like live, but also writes tests/fixtures/llm/ — run once to refresh.
#   fixture  replay recorded responses only; a miss is an error. Used by tests.
ANTHROPIC_API_KEY=
LLM_MODE=off
LLM_MODEL=claude-opus-5
